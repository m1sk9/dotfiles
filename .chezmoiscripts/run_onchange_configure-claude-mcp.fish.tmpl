#!/usr/bin/env fish

# MCP サーバー定義の source of truth は .chezmoitemplates/mcp-servers.json．
#
# Why not ファイルとして配置: user scope の MCP 定義先は ~/.claude.json のみで，
# そこは numStartups や projects などの可変状態を含むため chezmoi の管理対象にできない．
# CLI 経由で注入すれば状態ファイルには触らず定義だけを単一の source に保てる．
#
# Why not .mcp.json: project scope はそのリポジトリでしか読まれず，全プロジェクトで
# 使いたい browser (Kitesurf) には届かない．
#
# Why not ローカル Chrome も user scope: browser と同名で local scope に入れると
# scope 優先順位 (local > project > user) で user 側が隠れ，ブラウザ MCP は常に
# 1 つしか起動しない．その投入は fish の claude 関数 (--chrome) が持つ．
#
# Why not obsidian の token を平文で持つ: Authorization ヘッダーは age で暗号化した
# .obsidian-token.age をテンプレート内で decrypt して埋める．ドット始まりのソース
# ファイルは chezmoi が展開対象から外すので $HOME に平文は落ちない．run_onchange が
# state に残すのも内容の SHA256 と実行時刻だけ (chezmoi state dump で確認済み)．

if not command -q claude
    echo "claude command not found; skipping MCP server configuration"
    exit 0
end

{{ $servers := (includeTemplate "mcp-servers.json" . | fromJson).mcpServers -}}
{{ range $name, $config := $servers }}
# Why not add-json のみ: 既存エントリがあると add-json が失敗するため，先に落とす
claude mcp remove {{ $name }} --scope user >/dev/null 2>&1
claude mcp add-json {{ $name }} '{{ $config | toJson }}' --scope user
{{ end -}}
