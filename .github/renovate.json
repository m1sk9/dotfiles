{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>m1sk9/renovate-config"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["/^\\.chezmoiexternal\\.toml\\.tmpl$/"],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)[\\s\\S]*?\\$statusbarVersion\\s*:=\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
            ]
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/^dot_config/herdr/plugins/config/herdr-lazy/plugins\\.list$/"],
            "matchStrings": [
                "(?<depName>[\\w.-]+/[\\w.-]+)@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
            ],
            "datasourceTemplate": "github-releases"
        }
    ]
}
