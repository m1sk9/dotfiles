{
  "enable_language_server": true,
  "format_on_save": "on",
  "languages": {
    "Rust": {
      "language_servers": ["rust-analyzer"],
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
          "extraArgs": ["--all-features"],
        },
      },
    },
  },
}
