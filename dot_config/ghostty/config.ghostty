auto-update-channel = stable
confirm-close-surface = false
copy-on-select = true
cursor-style-blink = false
font-family = "PlemolJP35 Console NF"
font-feature = -calt
font-feature = -dlig
font-feature = -liga
font-size = 13
keybind = cmd+c=copy_to_clipboard:plain
keybind = cmd+i=text:cdi\n
keybind = ctrl+cmd+a=text:zi\n
keybind = ctrl+cmd+c=text:claude\n
keybind = ctrl+cmd+r=toggle_readonly
keybind = ctrl+cmd+s=text:lazygit\n
keybind = global:cmd+grave_accent=toggle_quick_terminal
# Why: 既定で cmd+1..9 は Ghostty 自身のタブ切り替え (goto_tab / last_tab) に
# 割り当て済みで，herdr に渡る前に消費されてしまう．herdr 側の switch_tab に
# 使わせるため unbind してパススルーさせる．
keybind = cmd+digit_1=unbind
keybind = cmd+digit_2=unbind
keybind = cmd+digit_3=unbind
keybind = cmd+digit_4=unbind
keybind = cmd+digit_5=unbind
keybind = cmd+digit_6=unbind
keybind = cmd+digit_7=unbind
keybind = cmd+digit_8=unbind
keybind = cmd+1=unbind
keybind = cmd+2=unbind
keybind = cmd+3=unbind
keybind = cmd+4=unbind
keybind = cmd+5=unbind
keybind = cmd+6=unbind
keybind = cmd+7=unbind
keybind = cmd+8=unbind
keybind = cmd+9=unbind
keybind = shift+enter=text:\x1b\r
macos-secure-input-indication = false
macos-titlebar-proxy-icon = hidden
macos-titlebar-style = tabs
macos-window-buttons = hidden
maximize = true
mouse-hide-while-typing = true
mouse-reporting = true
quick-terminal-animation-duration = 0.2
quick-terminal-autohide = true
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-size = 50%
quick-terminal-space-behavior = move
split-inherit-working-directory = true
tab-inherit-working-directory = false
term = xterm-256color
theme = Gruvbox Dark Hard
window-height = 100
window-inherit-working-directory = false
window-padding-x = 10
window-padding-y = 10
window-theme = dark
window-width = 100
