{
  "mcpServers": {
    "browser": {
      "type": "stdio",
      "command": "bunx",
      "args": [
        "chrome-devtools-mcp",
        "--wsEndpoint=wss://kitesurf.cloudflare.app/devtools/browser"
      ]
    },
    "obsidian": {
      "type": "http",
      "url": "http://127.0.0.1:27123/mcp/",
      "headers": {
        "Authorization": "{{ joinPath .chezmoi.sourceDir `.obsidian-token.age` | include | decrypt | trim }}"
      }
    }
  }
}
