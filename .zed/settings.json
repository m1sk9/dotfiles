// Project settings for editing this chezmoi source directory.
// Lua Language Server options live in .luarc.json because Zed reads them from there.
{
  // LSP is off globally (~/.config/zed/settings.json). Opt in here with an explicit
  // list: without "...", Zed does not pull in servers beyond the ones named.
  "enable_language_server": true,
  "language_servers": ["lua-language-server", "vtsls"],
  // chezmoi prefixes and .tmpl suffixes hide the real file type from Zed.
  "file_types": {
    "Lua": ["*.lua.tmpl"],
    "Fish": ["*.fish.tmpl"],
    "TOML": ["*.toml.tmpl"],
    "Git Config": ["dot_gitconfig"],
  },
  "languages": {
    "Lua": {
      "tab_size": 2,
    },
    "Fish": {
      "tab_size": 4,
    },
    // Why not format on save: the usage-alert mod is not Prettier-clean at any
    // print width, so saving would reflow hand-kept one-liners in the tests.
    // The options still match its style for an explicit `editor: format`.
    "TypeScript": {
      "tab_size": 2,
      "format_on_save": "off",
      "prettier": {
        "semi": false,
        "singleQuote": true,
        "arrowParens": "avoid",
        "printWidth": 100,
      },
    },
  },
}
